{
  "name": "min-dark-vscode",
  "displayName": "Min Dark",
  "description": "A minimal dark and light theme for VS Code, with solid and blurred variants.",
  "version": "0.0.1",
  "publisher": "vv1ktor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vv1ktor/min-dark-vscode.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Min Dark (Solid)",
        "uiTheme": "vs-dark",
        "path": "./themes/min-dark-solid-color-theme.json"
      },
      {
        "label": "Min Dark (Blurred)",
        "uiTheme": "vs-dark",
        "path": "./themes/min-dark-blurred-color-theme.json"
      },
      {
        "label": "Min Light (Solid)",
        "uiTheme": "vs",
        "path": "./themes/min-light-solid-color-theme.json"
      },
      {
        "label": "Min Light (Blurred)",
        "uiTheme": "vs",
        "path": "./themes/min-light-blurred-color-theme.json"
      }
    ]
  }
}
